# AWS Terraform 변수 예시 파일
# 이 파일을 terraform.tfvars로 복사하고 실제 값으로 수정하세요

# AWS 인증 정보
access_key = "your-aws-access-key"
secret_key = "your-aws-secret-key"

# AWS 설정
region = "ap-northeast-2"
aws_region = "ap-northeast-2"
eks_cluster_name = "ott-eks"
profile_name = "admin"

# SSH 키 페어
key_pair_name = "your-key-pair-name"

# IP 설정
my_ip = "your-public-ip/32"

# 데이터베이스
db_password = "your-database-password"

# SSL 인증서
certificate_arn = "arn:aws:acm:ap-northeast-2:your-account:certificate/your-certificate-id"

# IAM 사용자
iam_user_arn = "arn:aws:iam::your-account:user/your-username"

# GCP 설정
gcp_vpc_private_cidr_block = "10.10.2.0/24"
gcp_fastapi_private_ip = "10.10.2.10"

# FastAPI 시크릿 키
fastapi_secret_key = "your-secret-key" 